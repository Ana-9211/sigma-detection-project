[{
  "title": "File Download via Certutil or Bitsadmin",
  "id": "1e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a5b",
  "description": "Detects use of certutil.exe or bitsadmin.exe to download files, a common living-off-the-land technique for retrieving second-stage payloads",
  "sigmafile": "",
  "sigma": [
    "SELECT * FROM logs WHERE EventID=1 AND ((Image LIKE '%\\\\certutil.exe' ESCAPE '\\' OR Image LIKE '%\\\\bitsadmin.exe' ESCAPE '\\') AND (CommandLine LIKE '%urlcache%' ESCAPE '\\' OR CommandLine LIKE '%-split%' ESCAPE '\\' OR CommandLine LIKE '%/transfer%' ESCAPE '\\' OR CommandLine LIKE '%http%' ESCAPE '\\'))"
  ],
  "rule_level": "medium",
  "tags": [
    "attack.command-and-control",
    "attack.t1105"
  ],
