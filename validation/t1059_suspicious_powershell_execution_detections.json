    "SELECT * FROM logs WHERE (Image LIKE '%\\\\powershell.exe' ESCAPE '\\' OR Image LIKE '%\\\\pwsh.exe' ESCAPE '\\') AND (CommandLine LIKE '%-enc%' ESCAPE '\\' OR CommandLine LIKE '%-EncodedCommand%' ESCAPE '\\' OR CommandLine LIKE '%-w hidden%' ESCAPE '\\' OR CommandLine LIKE '%-windowstyle hidden%' ESCAPE '\\' OR CommandLine LIKE '%IEX%' ESCAPE '\\' OR CommandLine LIKE '%DownloadString%' ESCAPE '\\' OR CommandLine LIKE '%Invoke-Expression%' ESCAPE '\\' OR CommandLine LIKE '%Net.WebClient%' ESCAPE '\\')"
  ],
  "rule_level": "high",
