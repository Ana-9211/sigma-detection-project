[{
  "title": "Process Spawned by WMI Provider Host (Possible Remote WMI Execution)",
  "id": "2f3a4b5c-6d7e-4f8a-9b0c-1d2e3f4a5b6c",
  "description": "Detects a process created with WmiPrvSE.exe as its parent, consistent with remote or local WMI-based command execution (e.g. wmiexec, PowerShell WMI cmdlets, Impacket wmiexec.py)",
  "sigmafile": "",
  "sigma": [
    "SELECT * FROM logs WHERE EventID=1 AND (ParentImage LIKE '%\\\\WmiPrvSE.exe' ESCAPE '\\' AND (NOT (Image LIKE '%\\\\wmiprvse.exe' ESCAPE '\\' OR Image LIKE '%\\\\conhost.exe' ESCAPE '\\')))"
  ],
  "rule_level": "medium",
  "tags": [
    "attack.execution",
    "attack.t1047"
  ],
