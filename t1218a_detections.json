    "SELECT * FROM logs WHERE EventID=1 AND (Image LIKE '%\\\\rundll32.exe' ESCAPE '\\' AND (CommandLine LIKE '%zipfldr%' ESCAPE '\\' OR CommandLine LIKE '%shdocvw%' ESCAPE '\\' OR CommandLine LIKE '%advpack%' ESCAPE '\\' OR CommandLine LIKE '%pcwutl%' ESCAPE '\\' OR CommandLine LIKE '%ExtExport%' ESCAPE '\\' OR CommandLine LIKE '%comsvcs%' ESCAPE '\\' OR CommandLine LIKE '%MiniDump%' ESCAPE '\\'))"
  ],
  "rule_level": "high",
