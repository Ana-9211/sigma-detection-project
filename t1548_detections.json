[{
  "title": "Suspicious Child Process from Known UAC Auto-Elevate Binary",
  "id": "7a8b9c0d-1e2f-4a3b-4c5d-6e7f8a9b0c1d",
  "description": "Detects cmd.exe or powershell.exe spawned as a child of Windows binaries known to auto-elevate without a UAC prompt, a common UAC bypass pattern",
  "sigmafile": "",
  "sigma": [
    "SELECT * FROM logs WHERE EventID=1 AND ((Image LIKE '%\\\\cmd.exe' ESCAPE '\\' OR Image LIKE '%\\\\powershell.exe' ESCAPE '\\') AND (ParentImage LIKE '%\\\\fodhelper.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\eventvwr.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\sdclt.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\cmstp.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\CompMgmtLauncher.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\slui.exe' ESCAPE '\\' OR ParentImage LIKE '%\\\\WSReset.exe' ESCAPE '\\'))"
  ],
  "rule_level": "high",
  "tags": [
    "attack.privilege-escalation",
    "attack.defense-evasion",
    "attack.t1548.002"
  ],
